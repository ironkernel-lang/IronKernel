<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IronKernel</RootNamespace>
    <AssemblyName>IronKernel.Runtime</AssemblyName>
    <Tailcalls>true</Tailcalls>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>IronKernel.Runtime</PackageId>
    <Description>The IronKernel core: the Kernel AST, evaluator, symbol table, primitives, and CLR interop. Hosts that embed IronKernel reference this and the IronKernel package.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ironkernel;kernel;lisp;scheme;interpreter</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Monads.fs" />
    <Compile Include="Ast.fs" />
    <Compile Include="Capabilities.fs" />
    <Compile Include="Errors.fs" />
    <Compile Include="SymbolTable.fs" />
    <Compile Include="Contracts.fs" />
    <Compile Include="ClrSugar.fs" />
    <Compile Include="Eval.fs" />
    <Compile Include="RuntimeDispatch.fs" />
    <Compile Include="ClrBindings.fs" />
    <Compile Include="Arithmetic.fs" />
    <Compile Include="Interop.fs" />
    <Compile Include="Generated\Bindings.Safe.fs" />
    <Compile Include="Runtime.fs" />
  </ItemGroup>
</Project>
