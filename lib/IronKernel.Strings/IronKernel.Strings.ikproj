<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageId>IronKernel.Strings</PackageId>
    <Version>0.1.0</Version>
    <Authors>IronKernel</Authors>
    <Description>String and format utilities for IronKernel: search, split/join, case, trimming, padding, characters, invariant number conversion, and a variadic culture-invariant format -- ordinal semantics throughout.</Description>
    <PackageTags>ironkernel</PackageTags>
    <IronKernelMain>src/strings.ikr</IronKernelMain>
    <IronKernelProfile>unrestricted</IronKernelProfile>
  </PropertyGroup>
  <ItemGroup>
    <IronKernelSource Include="src/**/*.ikr" />
    <IronKernelTest Include="test/**/*.ikr" />
    <PackageReference Include="IronKernel.Test" Version="0.1.0" IronKernelKind="IronKernel" IronKernelScope="test" />
  </ItemGroup>
</Project>
