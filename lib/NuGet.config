<?xml version="1.0" encoding="utf-8"?>
<!--
  Local package sources for the first-party packages in this directory, so a
  lib package can reference a sibling before it is published to NuGet.org.
  Seed a source by packing the dependency first: `ik pack` in its directory.

  Packages that consume a sibling this way do not commit packages.lock.json:
  a locally packed .nupkg has no stable content hash, so a committed lock
  would fail locked restore on every other machine.
-->
<configuration>
  <packageSources>
    <add key="ironkernel-lib-test" value="IronKernel.Test/bin" />
    <add key="ironkernel-lib-strings" value="IronKernel.Strings/bin" />
    <add key="ironkernel-lib-collections" value="IronKernel.Collections/bin" />
  </packageSources>
</configuration>
