; Tests for IronKernel.Amb, written with IronKernel.Test (a test-scoped
; package reference).

(suite "choice points"
  (check-equal "amb enumerates a list"
    (list 1 2 3) (collect (emit (amb (list 1 2 3)))))
  (check-equal "amb over () fails"
    () (collect (emit (amb ()))))
  (check-equal "nested amb takes the cross product"
    4 (length (collect (let ((a (amb (list 1 2))))
                         (let ((b (amb (list 10 20))))
                           (emit (cons a b)))))))
  (check-equal "amb-range enumerates a half-open interval"
    (list 2 3 4) (collect (emit (amb-range 2 5))))
  (check-equal "require prunes a branch"
    (list 0 1 2) (collect (let ((a (amb-range 0 10)))
                            (require (< a 3))
                            (emit a))))
  (check-equal "fail abandons a branch"
    (list 1 3) (collect (let ((a (amb (list 1 2 3))))
                          (if (eq? a 2) (fail) #inert)
                          (emit a)))))

(suite "strategies"
  (check-equal "count-of tallies solutions"
    4 (count-of (emit (amb-range 0 4))))
  (check-equal "first-of returns the first solution"
    6 (first-of (let ((a (amb (list 5 6 7))))
                  (require (> a 5))
                  (emit a))))
  (check-equal "first-of returns () when there is none"
    () (first-of (let ((a (amb (list 1 2)))) (fail) (emit a))))
  (check "search accepts a custom handler"
    (let ((total (make-vector 1 0)))
      (search (lambda (s) (vector-set! total 0 (+ (vector-ref total 0) s)))
        (emit (amb-range 1 5)))
      (eq? 10 (vector-ref total 0))))
  (check "emit outside a strategy is a no-op"
    (begin (emit (string->symbol "ignored")) #t))
  (check-equal "strategies nest"
    (list 0 1 2) (collect (let ((a (amb-range 0 3)))
                            (emit (count-of (emit (amb-range 0 a))))))))

; --- bracketed choice -------------------------------------------------------

(define st (make-vector 1 0))

(defn (bump v) (vector-set! st 0 (+ (vector-ref st 0) v)))
(defn (drop v) (vector-set! st 0 (- (vector-ref st 0) v)))

(suite "bracketed choice"
  (check-equal "amb-bracket exposes state to the continuation"
    (list 1 2 3) (collect (let ((x (amb-bracket (list 1 2 3)
                                                (lambda (v) #t) bump drop)))
                            (emit (vector-ref st 0)))))
  (check "amb-bracket restores state afterwards"
    (zero? (vector-ref st 0)))
  (check-equal "amb-bracket honours its guard"
    (list 1 2) (collect (let ((x (amb-bracket (list 1 2 3 4)
                                              (lambda (v) (< v 3)) bump drop)))
                          (emit x))))
  (check "amb-bracket-range brackets nested choices"
    (let ((seen (collect (let ((a (amb-bracket-range 1 4
                                    (lambda (v) #t) bump drop)))
                           (let ((b (amb-bracket-range 1 4
                                      (lambda (v) (> v a)) bump drop)))
                             (emit (vector-ref st 0)))))))
      ; a+b over 1<=a<b<=3: 1+2, 1+3, 2+3
      (if (equal? seen (list 3 4 5)) (zero? (vector-ref st 0)) #f)))
  (check "first-of unwinds nested bracket state before escaping"
    (begin
      (vector-set! st 0 0)
      (let ((found
              (first-of
                (let ((a (amb-bracket (list 1 2)
                                      (lambda (v) #t) bump drop)))
                  (let ((b (amb-bracket-range 2 4
                                              (lambda (v) #t) bump drop)))
                    (emit (+ a b)))))))
        (if (eq? found 3) (zero? (vector-ref st 0)) #f)))))

; --- integration: n-queens --------------------------------------------------
;
; Constant width 1 in the sense of Examples/constant-width-amb.ikr: one queen
; per row, no two sharing a column or a diagonal.

(defn (queens n)
  (let ((col (make-vector n 0))
        (d1 (make-vector (- (* 2 n) 1) 0))
        (d2 (make-vector (- (* 2 n) 1) 0))
        (acc (make-vector 1 ())))
    (letrec
      ((i1 (lambda (x y) (+ x y)))
       (i2 (lambda (x y) (- (+ n (- x y)) 1)))
       (free? (lambda (x y)
                (if (zero? (vector-ref col y))
                  (if (zero? (vector-ref d1 (i1 x y)))
                    (zero? (vector-ref d2 (i2 x y)))
                    #f)
                  #f)))
       (mark! (lambda (x y d)
                (vector-set! col y (+ (vector-ref col y) d))
                (vector-set! d1 (i1 x y) (+ (vector-ref d1 (i1 x y)) d))
                (vector-set! d2 (i2 x y) (+ (vector-ref d2 (i2 x y)) d))))
       (enter! (lambda (x) (lambda (y)
                 (mark! x y 1)
                 (vector-set! acc 0 (cons y (vector-ref acc 0))))))
       (leave! (lambda (x) (lambda (y)
                 (mark! x y -1)
                 (vector-set! acc 0 (cdr (vector-ref acc 0))))))
       (go (lambda (x)
             (if (eq? x n)
               (emit (vector-ref acc 0))
               (let ((y (amb-bracket-range 0 n
                          (lambda (c) (free? x c))
                          (enter! x)
                          (leave! x))))
                 (go (+ x 1)))))))
      (go 0))))

(suite "integration: n-queens"
  (check-equal "6-queens has 4 solutions" 4 (count-of (queens 6)))
  (check-equal "5-queens has 10 solutions" 10 (count-of (queens 5)))
  (check-equal "queens leaves no state behind" 6 (length (first-of (queens 6)))))

(report-checks)
