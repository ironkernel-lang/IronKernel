<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PackageId>IronKernel.Test</PackageId>
    <Version>0.1.0</Version>
    <Authors>IronKernel</Authors>
    <Description>A small testing DSL for IronKernel: checks as operatives that report the failing source form, error-signalling assertions, suites, and a tally that fails `ik test` when a check does.</Description>
    <PackageTags>ironkernel</PackageTags>
    <IronKernelMain>src/test.ikr</IronKernelMain>
    <IronKernelProfile>unrestricted</IronKernelProfile>
  </PropertyGroup>
  <ItemGroup>
    <IronKernelSource Include="src/**/*.ikr" />
    <IronKernelTest Include="test/**/*.ikr" />
  </ItemGroup>
</Project>
