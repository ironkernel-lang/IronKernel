<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IronKernel</RootNamespace>
    <AssemblyName>IronKernel</AssemblyName>
    <Tailcalls>true</Tailcalls>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ik</ToolCommandName>
    <PackageId>IronKernel.Tool</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- This exe doubles as a library (hosts reference it for the parser,
         compiler, and kernel.ikr). Without this, a referencing app's
         self-contained publish flows RuntimeIdentifier/SelfContained in here
         and builds it once per RID — which breaks cross-compiles
         (NETSDK1047/NETSDK1152). Publishing ik itself with -r is unaffected:
         this only rejects RID/SelfContained arriving via ProjectReference.
         The Allow… pair covers publish-walk calls that leak
         SelfContained/PublishSingleFile globals without a RID (with inference
         declined those would assert NETSDK1191); on a build that is not
         itself publishing they are no-ops. -->
    <IsRidAgnostic>true</IsRidAgnostic>
    <AllowSelfContainedWithoutRuntimeIdentifier>true</AllowSelfContainedWithoutRuntimeIdentifier>
    <AllowPublishSingleFileWithoutRuntimeIdentifier>true</AllowPublishSingleFileWithoutRuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source.fs" />
    <Compile Include="Parser.fs" />
    <Compile Include="RuntimeSourceServices.fs" />
    <Compile Include="Ir.fs" />
    <Compile Include="Analyze.fs" />
    <Compile Include="CorePackage.fs" />
    <Compile Include="PartialEval.fs" />
    <Compile Include="Compiler.fs" />
    <Compile Include="StaticCompiler.fs" />
    <Compile Include="StaticEmit.fs" />
    <Compile Include="Emit.fs" />
    <Compile Include="Repl.fs" />
    <Compile Include="Project.fs" />
    <Compile Include="Program.fs" />
    <!-- Pack=false: keep stdlib in the tool output (tools/net*/any) only, not as package contentFiles. -->
    <Content Include="kernel.ikr" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <Content Include="promises.ikr" CopyToOutputDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FParsec" Version="1.1.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\IronKernel.Runtime\IronKernel.Runtime.fsproj" />
    <ProjectReference Include="..\Mono.Terminal\Mono.Terminal.csproj" />
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
